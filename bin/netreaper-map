#!/usr/bin/env python3
# NETREAPER - Holographic WiFi Discovery Map Server
#
# Purpose:
#   Serve the dependency-free holographic map UI and provide a tiny JSON API
#   that reads scan output generated by `netreaper wifi scan`.
#
# Security / intent:
#   This is a visualization layer. Use it only on networks you own or have
#   explicit authorization to assess.

from __future__ import annotations

import argparse
import json
import os
import socketserver
import threading
import time
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler
from pathlib import Path
from typing import Any, Dict, Optional, Tuple


def _default_data_path() -> Path:
    return Path.home() / ".netreaper" / "output" / "wifi_scan_latest.json"


def _repo_root_from_script() -> Path:
    return Path(__file__).resolve().parent.parent


class _Handler(SimpleHTTPRequestHandler):
    server_version = "NETREAPER-Map/1.0"

    def __init__(self, *args: Any, **kwargs: Any) -> None:
        self._ui_dir: Path = kwargs.pop("ui_dir")
        self._data_path: Path = kwargs.pop("data_path")
        super().__init__(*args, directory=str(self._ui_dir), **kwargs)

    def log_message(self, fmt: str, *args: Any) -> None:
        # Keep it quiet unless user is debugging.
        if os.environ.get("NETREAPER_MAP_VERBOSE") == "1":
            super().log_message(fmt, *args)

    def _send_json(self, payload: Dict[str, Any], status: int = 200) -> None:
        raw = json.dumps(payload, indent=2, sort_keys=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _read_scan_json(self) -> Tuple[Dict[str, Any], Optional[str]]:
        path = self._data_path
        if not path.exists():
            return (
                {
                    "generated_at": "",
                    "iface": "",
                    "backend": "",
                    "networks": [],
                    "note": f"Scan JSON not found at: {str(path)}",
                },
                None,
            )
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(data, dict):
                raise ValueError("Scan JSON is not an object")
            # Minimal contract normalization:
            data.setdefault("networks", [])
            data.setdefault("generated_at", "")
            data.setdefault("iface", "")
            data.setdefault("backend", "")
            return data, None
        except Exception as e:
            return (
                {
                    "generated_at": "",
                    "iface": "",
                    "backend": "",
                    "networks": [],
                    "error": f"Failed to read scan JSON: {e}",
                },
                str(e),
            )

    def do_GET(self) -> None:
        if self.path.startswith("/api/networks/latest"):
            data, _err = self._read_scan_json()
            return self._send_json(data, status=200)

        if self.path.startswith("/api/health"):
            return self._send_json({"ok": True}, status=200)

        # fall back to static
        return super().do_GET()


def _serve(host: str, port: int, ui_dir: Path, data_path: Path) -> None:
    class _TCP(socketserver.ThreadingMixIn, socketserver.TCPServer):
        allow_reuse_address = True

    def handler_factory(*args: Any, **kwargs: Any) -> _Handler:
        return _Handler(*args, ui_dir=ui_dir, data_path=data_path, **kwargs)

    with _TCP((host, port), handler_factory) as httpd:
        print(f"[NETREAPER] Holographic map server running:")
        print(f"  UI:   http://{host}:{port}/")
        print(f"  API:  http://{host}:{port}/api/networks/latest")
        print(f"  Data: {data_path}")
        print()
        try:
            httpd.serve_forever(poll_interval=0.5)
        except KeyboardInterrupt:
            print("\n[NETREAPER] Map server stopped.")


def main() -> int:
    ap = argparse.ArgumentParser(prog="netreaper-map", add_help=True)
    ap.add_argument("--host", default="127.0.0.1", help="Bind host (default: 127.0.0.1)")
    ap.add_argument("--port", type=int, default=8787, help="Bind port (default: 8787)")
    ap.add_argument("--data", type=str, default=str(_default_data_path()), help="Path to wifi scan JSON")
    ap.add_argument("--ui", type=str, default="", help="Path to UI directory (defaults to repo ui/holo_map)")
    args = ap.parse_args()

    repo = _repo_root_from_script()
    ui_dir = Path(args.ui).expanduser().resolve() if args.ui else (repo / "ui" / "holo_map")
    data_path = Path(args.data).expanduser().resolve()

    if not ui_dir.exists():
        print(f"[NETREAPER] ERROR: UI directory not found: {ui_dir}")
        return 2

    # Ensure the data parent exists (nice UX)
    try:
        data_path.parent.mkdir(parents=True, exist_ok=True)
    except Exception:
        pass

    _serve(args.host, args.port, ui_dir, data_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
