#!/usr/bin/env python3
"""
NetReaper Pipeline Manager

Manages automated task queues for penetration testing workflows.
Supports sequential and concurrent execution with pause/resume capabilities.
"""

import asyncio
import argparse
import json
import os
import sys
import uuid
from datetime import datetime
from pathlib import Path
import subprocess
import signal
import yaml

# Configuration
NETREAPER_ROOT = Path(__file__).parent.parent
CONFIG_DIR = Path.home() / ".netreaper"
JOBS_FILE = CONFIG_DIR / "jobs.json"
MAX_CONCURRENCY = int(os.environ.get("NR_MAX_CONCURRENCY", "2"))

class PipelineManager:
    def __init__(self):
        self.jobs = {}
        self.running_tasks = {}
        self.load_jobs()

    def load_jobs(self):
        """Load jobs from JSON file"""
        if JOBS_FILE.exists():
            with open(JOBS_FILE, 'r') as f:
                self.jobs = json.load(f)
        else:
            self.jobs = {}

    def save_jobs(self):
        """Save jobs to JSON file"""
        CONFIG_DIR.mkdir(exist_ok=True)
        with open(JOBS_FILE, 'w') as f:
            json.dump(self.jobs, f, indent=2, default=str)

    def add_job(self, job_data):
        """Add a new job to the queue"""
        job_id = str(uuid.uuid4())
        job = {
            "id": job_id,
            "status": "queued",
            "created_at": datetime.now().isoformat(),
            "pid": None,
            **job_data
        }
        self.jobs[job_id] = job
        self.save_jobs()
        print(f"Added job {job_id}")
        return job_id

    def list_jobs(self):
        """List all jobs"""
        if not self.jobs:
            print("No jobs in queue")
            return

        print("Job Queue:")
        print("-" * 80)
        for job_id, job in self.jobs.items():
            status = job.get("status", "unknown")
            target = job.get("target", "N/A")
            wizard = job.get("wizard", "N/A")
            created = job.get("created_at", "N/A")
            print(f"{job_id[:8]} | {status:8} | {target:15} | {wizard:12} | {created}")

    def pause_job(self, job_id):
        """Pause a running job"""
        if job_id not in self.jobs:
            print(f"Job {job_id} not found")
            return False

        job = self.jobs[job_id]
        if job["status"] != "running":
            print(f"Job {job_id} is not running")
            return False

        pid = job.get("pid")
        if pid:
            try:
                os.kill(pid, signal.SIGSTOP)
                job["status"] = "paused"
                self.save_jobs()
                print(f"Paused job {job_id}")
                return True
            except ProcessLookupError:
                print(f"Process {pid} not found")
                return False
        return False

    def resume_job(self, job_id):
        """Resume a paused job"""
        if job_id not in self.jobs:
            print(f"Job {job_id} not found")
            return False

        job = self.jobs[job_id]
        if job["status"] != "paused":
            print(f"Job {job_id} is not paused")
            return False

        pid = job.get("pid")
        if pid:
            try:
                os.kill(pid, signal.SIGCONT)
                job["status"] = "running"
                self.save_jobs()
                print(f"Resumed job {job_id}")
                return True
            except ProcessLookupError:
                print(f"Process {pid} not found")
                return False
        return False

    def cancel_job(self, job_id):
        """Cancel a job"""
        if job_id not in self.jobs:
            print(f"Job {job_id} not found")
            return False

        job = self.jobs[job_id]
        if job["status"] == "running":
            pid = job.get("pid")
            if pid:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass

        job["status"] = "cancelled"
        self.save_jobs()
        print(f"Cancelled job {job_id}")
        return True

    async def run_job(self, job_id):
        """Execute a single job"""
        job = self.jobs[job_id]
        job["status"] = "running"
        self.save_jobs()

        try:
            # Build command
            wizard = job.get("wizard")
            target = job.get("target")
            params = job.get("params", {})

            cmd = [str(NETREAPER_ROOT / "bin" / "netreaper"), f"wizard {wizard}"]
            if target:
                cmd.append(target)

            # Add params as environment variables
            env = os.environ.copy()
            for key, value in params.items():
                env[f"NR_{key.upper()}"] = str(value)

            print(f"Starting job {job_id}: {' '.join(cmd)}")

            # Run the command
            process = await asyncio.create_subprocess_exec(
                *cmd,
                env=env,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                cwd=NETREAPER_ROOT
            )

            job["pid"] = process.pid
            self.save_jobs()

            # Wait for completion
            stdout, stderr = await process.communicate()

            if process.returncode == 0:
                job["status"] = "completed"
                print(f"Job {job_id} completed successfully")
            else:
                job["status"] = "failed"
                print(f"Job {job_id} failed with return code {process.returncode}")
                if stderr:
                    print(f"Error: {stderr.decode()}")

        except Exception as e:
            job["status"] = "failed"
            print(f"Job {job_id} failed: {e}")

        finally:
            job["pid"] = None
            self.save_jobs()

    async def run_pipeline(self):
        """Run the pipeline, executing queued jobs"""
        semaphore = asyncio.Semaphore(MAX_CONCURRENCY)

        async def run_with_semaphore(job_id):
            async with semaphore:
                await self.run_job(job_id)

        # Get queued jobs
        queued_jobs = [jid for jid, job in self.jobs.items() if job["status"] == "queued"]

        if not queued_jobs:
            print("No queued jobs to run")
            return

        # Run jobs concurrently up to MAX_CONCURRENCY
        tasks = [run_with_semaphore(job_id) for job_id in queued_jobs]
        await asyncio.gather(*tasks)

def load_job_from_file(file_path):
    """Load job definition from YAML or JSON file"""
    with open(file_path, 'r') as f:
        if file_path.endswith('.yaml') or file_path.endswith('.yml'):
            return yaml.safe_load(f)
        else:
            return json.load(f)

def main():
    parser = argparse.ArgumentParser(description="NetReaper Pipeline Manager")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Add job
    add_parser = subparsers.add_parser("add", help="Add a job to the queue")
    add_parser.add_argument("--file", "-f", required=True, help="Job definition file (YAML or JSON)")
    add_parser.add_argument("--target", help="Override target")
    add_parser.add_argument("--wizard", help="Override wizard")

    # List jobs
    subparsers.add_parser("list", help="List all jobs")

    # Run pipeline
    subparsers.add_parser("run", help="Execute queued jobs")

    # Pause job
    pause_parser = subparsers.add_parser("pause", help="Pause a running job")
    pause_parser.add_argument("job_id", help="Job ID to pause")

    # Resume job
    resume_parser = subparsers.add_parser("resume", help="Resume a paused job")
    resume_parser.add_argument("job_id", help="Job ID to resume")

    # Cancel job
    cancel_parser = subparsers.add_parser("cancel", help="Cancel a job")
    cancel_parser.add_argument("job_id", help="Job ID to cancel")

    args = parser.parse_args()

    manager = PipelineManager()

    if args.command == "add":
        job_data = load_job_from_file(args.file)
        if args.target:
            job_data["target"] = args.target
        if args.wizard:
            job_data["wizard"] = args.wizard
        manager.add_job(job_data)

    elif args.command == "list":
        manager.list_jobs()

    elif args.command == "run":
        asyncio.run(manager.run_pipeline())

    elif args.command == "pause":
        manager.pause_job(args.job_id)

    elif args.command == "resume":
        manager.resume_job(args.job_id)

    elif args.command == "cancel":
        manager.cancel_job(args.job_id)

    else:
        parser.print_help()

if __name__ == "__main__":
    main()